# ==============================================================================
# MatrVaani Environment Variables Template
# Copy this file to .env and fill in your secrets. NEVER commit .env to git!
# ==============================================================================

# Hugging Face Access Token (Required for gated models: Indic Parler-TTS & Rasa dataset)
# Generate from: https://huggingface.co/settings/tokens
HF_TOKEN=hf_your_huggingface_access_token_here

# Colab GPU Bridge URL (e.g. TryCloudflare or Ngrok public tunnel)
# Used by the Web UI and local test scripts to reach the Colab GPU FastAPI server
COLAB_TUNNEL_URL=https://your-tunnel-subdomain.ngrok-free.dev

# Model & Training Paths
BASE_MODEL=ai4bharat/indic-parler-tts-pretrained
DATASET_NAME=ai4bharat/Rasa
DATASET_SPLIT=Santali
CHECKPOINT_DIR=./santali_tts/checkpoints/santali-parler-test
OUTPUT_DIR=./santali_tts/outputs

# FastAPI Server Port
PORT=8000
HOST=0.0.0.0
